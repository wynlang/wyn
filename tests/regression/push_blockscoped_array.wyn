// Pushing a block-scoped array/aggregate into an outer array used to be a
// heap-use-after-free (ASan) / silent wrong answer: array_push_array
// SHALLOW-copied the nested WynArray, aliasing its backing store, and codegen
// emits array_free(&row) at block-scope end, so the outer element dangled and
// c[0][0] read freed memory -> printed 0. Fixed: array_push_array DEEP-copies
// the nested backing store (and nested-of-nested, retaining RC strings).
// EXPECT: 11
// EXPECT: 22
// EXPECT: 99
// EXPECT: 100
// EXPECT: 0
// EXPECT: 5
// EXPECT: 7
// EXPECT: 12
// EXPECT: 7
// EXPECT: 8

fn main() {
    // while-block push
    var c = []
    var i = 0
    while i < 1 {
        var row = []
        row.push(11)
        row.push(22)
        c.push(row)
        i = i + 1
    }
    println(c[0][0])
    println(c[0][1])

    // if-block push
    var d = []
    if true {
        var r2 = []
        r2.push(99)
        r2.push(100)
        d.push(r2)
    }
    println(d[0][0])
    println(d[0][1])

    // matmul-style: build rows via push, read diagonal
    var m = []
    var a = 0
    while a < 3 {
        var mrow = []
        var b = 0
        while b < 3 { mrow.push(a * 3 + b); b = b + 1 }
        m.push(mrow)
        a = a + 1
    }
    println(m[0][0])
    println(m[1][2])
    println(m[2][1])
    var diag = 0
    var k = 0
    while k < 3 { diag = diag + m[k][k]; k = k + 1 }
    println(diag)

    // helper-fn-return path still works
    var h = []
    h.push(build())
    println(h[0][0])
    println(h[0][1])
}

fn build() -> [int] { var r = []; r.push(7); r.push(8); return r }

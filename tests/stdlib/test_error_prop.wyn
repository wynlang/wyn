// A checked string->int parse returning Result, i.e. exactly what user code
// should write on top of the v1.20.0 contract.
//
// The old version of this helper called `s.to_int()` FIRST and inferred failure
// from a returned 0. That only worked while `.to_int()` silently substituted 0
// for garbage - which v1.20.0 deliberately removed (it made "abc" and "0"
// indistinguishable). `.to_int()` now panics on garbage, so the validity check
// has to happen BEFORE the parse: `.is_numeric()` is the sanctioned guard.
// There is no Result-returning `try_to_int` in the language today; this function
// is how you build one.
fn parse_int(s: string) -> ResultInt {
    if not s.is_numeric() { return Err("not a number") }
    return Ok(s.to_int())
}

fn add_parsed(a: string, b: string) -> ResultInt {
    var x = parse_int(a)?
    var y = parse_int(b)?
    return Ok(x + y)
}

fn main() -> int {
    Test.init("Error Propagation (?)")
    
    var r1 = add_parsed("10", "20")
    Test.assert(r1.is_ok(), "ok case")
    Test.assert_eq_int(r1.unwrap(), 30, "10+20=30")
    
    var r2 = add_parsed("10", "abc")
    Test.assert(r2.is_err(), "error propagated")
    Test.assert_eq_str(r2.unwrap_err(), "not a number", "error message")
    
    var r3 = add_parsed("abc", "20")
    Test.assert(r3.is_err(), "first arg error propagated")

    // "0" is a VALID parse, not a failure - the distinction the v1.20.0
    // to_int change exists to preserve.
    var r4 = add_parsed("0", "0")
    Test.assert(r4.is_ok(), "\"0\" parses ok, is not treated as an error")
    Test.assert_eq_int(r4.unwrap(), 0, "0+0=0")

    // Empty string is garbage too, and must propagate as Err rather than panic.
    var r5 = add_parsed("", "1")
    Test.assert(r5.is_err(), "empty string propagates as Err")

    Test.summary()
    return 0
}

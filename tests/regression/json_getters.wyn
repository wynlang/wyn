// Regression: Json.get_string used to pass check then fail to LINK ("call to
// undeclared function 'Json_get_string'"). Also Json.keys now returns [string]
// so it can be iterated / len'd. get_int/get_bool/get_float still work.
// Json.get_bool now prints `true`, not `1` (V-30). Its two spellings disagreed:
// `d.get_bool(k)` was registered bool and `Json.get_bool(d, k)` int, so once a
// bool-typed call started rendering as true/false from one authority the namespace
// spelling would have been the only one still saying `1`. Json.has stays int on
// purpose - see the note beside it in types.c.
// EXPECT: alice
// EXPECT: 30
// EXPECT: true
// EXPECT: 9.5
// EXPECT: 4
// EXPECT: name
// EXPECT: age
// EXPECT: active
// EXPECT: true
fn main() {
    var j = Json.parse("{\"name\": \"alice\", \"age\": 30, \"active\": true, \"score\": 9.5}")
    var n = Json.get_string(j, "name")
    println(n)
    println("${Json.get_int(j, "age")}")
    println("${Json.get_bool(j, "active")}")
    println("${Json.get_float(j, "score")}")
    var ks = Json.keys(j)
    println("${ks.len()}")
    for k in ks {
        if k != "score" { println(k) }
    }
    println("${ks.contains("name")}")
}

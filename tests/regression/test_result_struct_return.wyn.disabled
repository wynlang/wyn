// DEFERRED / KNOWN-FAILING repro (2026-07-24) — NOT run by run_bdd.sh (the
// harness globs *.wyn; the .disabled suffix keeps this out of the suite).
//
// Bug 2c (second half): a function returning `Result<Struct, E>` fails C codegen.
// A plain struct-by-value return works (see test_struct_by_value_return.wyn), and
// Option<Struct> works (codegen generates a per-struct `Option<Name>` family), but
// Result<Struct, E> still monomorphizes to `ResultInt` whose ok payload is `int`:
//
//   return ResultInt_Ok(((Point){.x = 3, .y = 4}));   // Point -> int  (bad)
//   long long p = __match_val.data.ok_value;          // then p.x -> "member
//                                                      //   reference base type
//                                                      //   'long long' is not a
//                                                      //   structure or union"
//
// Fixing it requires replicating the entire per-struct Option family machinery for
// Result: a `Result<Name>` typedef + Ok/Err constructors + is_ok/unwrap members
// generated per struct (emit_*_struct_family), a checker registration pass
// (register_option_struct_family analogue), a codegen registry (register/​count/​
// name/​is_registered in codegen.c), and updating the ~15 Result return-type / match
// / var-decl / constructor resolution sites in codegen_program.c and codegen_stmt.c
// that currently hardcode ResultInt/ResultString/ResultFloat/ResultBool. That is
// deep, cross-file codegen surgery well beyond the scope of the accompanying fixes,
// so it is deferred here with this documented repro.
//
// To reproduce: rename to .wyn and `wyn run` — expect an internal codegen error.
struct Point { x: int, y: int }

fn find(ok: bool) -> Result<Point, string> {
    if ok {
        return Ok(Point{x: 3, y: 4})
    }
    return Err("no")
}

fn main() {
    r = find(true)
    match r {
        Ok(p) => println("found x=" + int_to_string(p.x)),
        Err(e) => println("err: " + e)
    }
    r2 = find(false)
    match r2 {
        Ok(p) => println("found x=" + int_to_string(p.x)),
        Err(e) => println("err: " + e)
    }
}

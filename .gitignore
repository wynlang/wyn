# Compiler binary
wyn
wyn-llvm
wyn-windows.exe
wyn-linux
wyn-macos

# Generated files from compilation
*.out
*.o
*.wyn.out
*.wyn.c
*.dSYM/

# Build directories
build/
temp/
.dev-scripts/

# Test executables (but not test source files)
tests/test_lexer
tests/test_parser
tests/test_checker
tests/test_codegen
!tests/*.c
!tests/*.h

# Compiled test programs. `wyn build tests/regression/x.wyn` drops an
# extensionless Mach-O/ELF binary next to the source, which the *.out / *.wyn.out
# rules above do NOT match - a dozen of them showed up as untracked files while
# staging v1.20.0. Ignore binaries in the test dirs while keeping the sources.
tests/regression/*
!tests/regression/*.wyn
!tests/regression/*.sh
tests/expect/*
!tests/expect/*.wyn
!tests/expect/*.sh
tests/stdlib/*
!tests/stdlib/*.wyn
!tests/stdlib/*.sh
!tests/stdlib/*.txt

# IDE
.vscode/
.idea/
*.swp
*.swo

# Logs and backups
*.log
*_backup.*
*.bak
*.bak[0-9]
*.backup
*.orig

# OS
.DS_Store

# Runtime build artifacts
runtime/libwyn_rt.a
runtime/obj/
wyn_cc_err.txt
runtime/libwyn_runtime.a
wyn_runtime.h.gch
# Precompiled header (regenerated; not linked or referenced by the build)
runtime/wyn_runtime.h.pch
*.pch

# Database files
*.db

# Test binaries (compiled from .wyn)
tests/concurrency/test_*
!tests/concurrency/test_*.wyn
tests/memory/test_*
!tests/memory/test_*.wyn
tests/validation/test_*
!tests/validation/test_*.wyn
tests/stdlib/test_*
!tests/stdlib/test_*.wyn
tests/test_*
!tests/test_*.wyn
!tests/test_*.c
# Compiled test-runner binary (source is run_tests.sh / .wyn, not this binary)
tests/run_tests
!tests/run_tests.sh
!tests/run_tests*.sh
runtime/libwyn_rt_asan.a
runtime/obj_asan/
runtime/libwyn_rt_tsan.a
runtime/obj_tsan/
# compiled expect-test binaries (no extension)
tests/expect/*
!tests/expect/*.wyn
!tests/expect/*.sh

# Compiled example programs - the same trap as tests/ above, and it was still
# open: `wyn build examples/x.wyn` drops an EXTENSIONLESS binary next to the
# source, which neither *.out nor *.wyn.out matches. Building every example
# during the 2026-08-10 release validation left 62 untracked binaries in here.
# The tests/ rules were added after this bit during v1.20.0 staging; examples/
# was missed, so it would have bitten again at v1.21.0 staging.
# Allowlist the SOURCE extensions rather than denylisting binaries: a compiled
# binary has no extension, so there is nothing to match on. (examples/*.c is
# allowed because examples/future_examples.c is a tracked source file.)
examples/*
!examples/*.wyn
!examples/*.sh
!examples/*.md
!examples/*.c
!examples/*.h
# ...but NOT the generated C that `--debug` emits: `x.wyn.c` matches *.c, so the
# allowlist above would un-ignore 64 generated files. Re-ignore that one shape.
examples/*.wyn.c
!examples/*.json
!examples/*.toml
!examples/*/

# Agent worktrees and session scratch - never part of the repo.
.claude/
fuzz_out/

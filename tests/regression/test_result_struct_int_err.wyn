// Regression: `Result<Struct, int>` — a struct ok-payload with a SCALAR (int) error
// type. Confirms the generalized per-struct Result family derives the err C type
// (`long long`) from E and binds the Err arm as an int (not a string). The `?`
// operator propagates the struct-ok/int-err Result too.
//
// EXPECT: ok x=5
// EXPECT: code=42
// EXPECT: chained x=6
struct Point { x: int, y: int }

fn find(ok: bool) -> Result<Point, int> {
    if ok {
        return Ok(Point{x: 5, y: 6})
    }
    return Err(42)
}

fn chain(ok: bool) -> Result<Point, int> {
    p = find(ok)?
    return Ok(Point{x: p.x + 1, y: p.y})
}

fn main() {
    match find(true) {
        Ok(p) => println("ok x=" + int_to_string(p.x)),
        Err(e) => println("code=" + int_to_string(e))
    }
    match find(false) {
        Ok(p) => println("ok x=" + int_to_string(p.x)),
        Err(e) => println("code=" + int_to_string(e))
    }
    match chain(true) {
        Ok(p) => println("chained x=" + int_to_string(p.x)),
        Err(e) => println("code=" + int_to_string(e))
    }
}

fn lcg_fill(n: int) -> [int] {
    var a: [int] = []
    var seed = 12345
    for i in 0..n {
        seed = (seed * 1103515245 + 12345) % 2147483648
        a.push(seed)
    }
    return a
}
fn main() -> int {
    for n in [10000, 100000, 1000000] {
        var a = lcg_fill(n)
        t0 = DateTime.micros()
        var s = a.sort()
        t1 = DateTime.micros()
        print("sort ${n} us=${t1 - t0} first=${s[0]}")
    }
    return 0
}

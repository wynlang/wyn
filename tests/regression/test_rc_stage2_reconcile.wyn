// Regression (RC move-analysis stage 2): the retain-on-return classifier (#32,
// wyn#197) and the existing move-out heuristics (dead-source move; struct-field,
// Some/Ok/Err, enum-arg raw-store moves; R4 return-liveness skip) must AGREE, so
// no code path both MOVES a string out AND retains it on return (that would
// over-retain -> leak) and no path does neither (that would under-count -> UAF).
// The five return shapes below are the interaction cases from
// docs/RC_OWNERSHIP_MODEL.md §7 Stage 2. Each is driven in a loop so a
// double-free crashes; correctness is the printed values. This file is also in
// the ASan suite (make asan-runtime-test) which proves no UAF/double-free, and
// RSS stays flat across all five (verified: ~1.5 MB at 2M iters, no growth).
//
//   Shape 1: string moved into a RETURNED enum payload (ctor is a call -> the
//            fn returns an enum, not a string, so retain-on-return never fires;
//            the enum stores the pointer raw and the caller's fresh arg is
//            released once). Balanced.
//   Shape 2: string moved into a RETURNED struct field. Same: fn returns a
//            struct, retain-on-return off; field holds the pointer raw. Balanced.
//   Shape 3: string moved into a RETURNED Option (Some). fn returns Option,
//            retain-on-return off; Some stores raw. Balanced.
//   Shape 4: alias local of a param returned (var t = s; return t). The local is
//            a BORROW of the param -> retain-on-return fires; R4 skips releasing
//            it (referenced by the return). Balanced.
//   Shape 5: fresh local moved out (var t = "x"+"y"; return t). Fresh producer
//            -> retain-on-return does NOT fire; R4 skips release; +1 moves to the
//            caller. Balanced (must NOT be retained, else leak).
// EXPECT: PASS: rc stage2 reconcile

enum Shape { Circle_str(string), Empty }
struct Point { name: string, x: int }

fn to_enum(s: string) -> Shape { return Shape.Circle_str(s) }        // shape 1
fn to_struct(s: string) -> Point { return Point { name: s, x: 1 } }  // shape 2
fn to_option(s: string) -> string? { return Some(s) }                // shape 3
fn alias_ret(s: string) -> string { var t = s; return t }            // shape 4
fn fresh_ret(k: int) -> string { var t = "x" + k.to_string(); return t } // shape 5

fn enum_str(sh: Shape) -> string {
    return match sh { Circle_str(v) => v, Empty => "empty" }
}

fn main() -> int {
    var i = 0
    var acc = 0
    // Drive every shape in a loop; a double-free (over-count) crashes here and a
    // leak shows up under the RSS check in the memory suite. The results are
    // consumed (acc) so nothing is optimized away.
    while i < 3000 {
        var a = "payload-" + i.to_string()
        var sh = to_enum(a)
        var es = enum_str(sh)              // read the payload back out of the enum
        var el = es.len()
        var b = "field-" + i.to_string()
        var p = to_struct(b)
        var pl = p.name.len()              // read the struct field
        var c = "opt-" + i.to_string()
        var o = to_option(c)
        var ol = 0
        match o { Some(v) => { ol = v.len() }, None => {} }
        var d = "alias-" + i.to_string()
        var e = alias_ret(d)               // borrowed-local alias returned
        var dl = e.len()
        var g = fresh_ret(i)               // fresh local moved out
        var gl = g.len()
        acc = acc + el + pl + ol + dl + gl
        i = i + 1
    }
    if acc <= 0 { println("FAIL: acc"); return 1 }

    // Correctness spot-checks of each shape.
    if enum_str(to_enum("hi")) != "hi" { println("FAIL: shape1 enum"); return 1 }
    if to_struct("nm").name != "nm" { println("FAIL: shape2 struct"); return 1 }
    var opt = to_option("val")
    match opt {
        Some(v) => { if v != "val" { println("FAIL: shape3 option"); return 1 } }
        None => { println("FAIL: shape3 none"); return 1 }
    }
    if alias_ret("world") != "world" { println("FAIL: shape4 alias"); return 1 }
    if fresh_ret(7) != "x7" { println("FAIL: shape5 fresh"); return 1 }

    println("PASS: rc stage2 reconcile")
    return 0
}

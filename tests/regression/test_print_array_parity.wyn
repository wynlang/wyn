// Regression: there are THREE array-element formatters in the runtime -
// print_array_elem (writes straight to stdout, allocation-free, used by the
// single-argument println fast path), wyn_out_elem (buffered, used by print,
// which must emit one fwrite so concurrent spawns cannot interleave), and
// array_to_string's inline switch (writes into a caller buffer, used by
// interpolation and by struct-field rendering).
//
// They drifted immediately: the first wyn_out_elem omitted WYN_TYPE_BOOL and fell
// through to the integer case, so print([true, false]) gave [1, 0] while
// println([true, false]) gave [true, false].
//
// Collapsing them into one function is NOT the fix - routing print_array_elem
// through the buffer adds an RC allocation per element on a printf path and
// segfaulted the stdlib suite on macos-15 while passing locally. So the two stay
// separate and this test pins their agreement: for every element type, print,
// println and "${a}" must render identically.
//
// EXPECT: [1, 2, 3]
// EXPECT: [1, 2, 3]
// EXPECT: [1.5, 2.5]
// EXPECT: [1.5, 2.5]
// EXPECT: [true, false, true]
// EXPECT: [true, false, true]
// EXPECT: ["a", "b"]
// EXPECT: ["a", "b"]
// EXPECT: []
// EXPECT: []
// EXPECT: [0, -1, 9223372036854775807]
// EXPECT: [0, -1, 9223372036854775807]
// EXPECT: [0, -1, 9223372036854775807]
// EXPECT: [[1, 2], [3]]
// EXPECT: [[1, 2], [3]]
// EXPECT: [[1, 2], [3]]
// EXPECT: [[[1], [2, 3]], [[4]]]
// EXPECT: [[["x"], ["y", "z"]]]
// EXPECT: [[1.5], [2.5]]
// EXPECT: [[true], [false]]
// EXPECT: [[]]
// EXPECT: [P { x: 1 }]
// EXPECT: [P { x: 1 }]
// EXPECT: [P { x: 1 }]

struct P { x: int }

fn main() {
    ints = [1, 2, 3]
    print(ints)
    println(ints)

    floats = [1.5, 2.5]
    print(floats)
    println(floats)

    bools = [true, false, true]
    print(bools)
    println(bools)

    strs = ["a", "b"]
    print(strs)
    println(strs)

    empty: [int] = []
    print(empty)
    println(empty)

    // Edge values: zero, negative, and INT64_MAX must render the same both ways.
    edges = [0, -1, 9223372036854775807]
    print(edges)
    println(edges)
    print("${edges}")

    // A NESTED array is a real WynValue tag, so all three formatters must
    // recurse. Each used to fall into `default:` and print the inner array's
    // heap pointer as a decimal - check-clean, exit 0, meaningless.
    nested = [[1, 2], [3]]
    print(nested)
    println(nested)
    print("${nested}")

    // Depth beyond two, and every element type nested, since each formatter
    // recurses through a different mechanism.
    print([[[1], [2, 3]], [[4]]])
    print([[["x"], ["y", "z"]]])
    print([[1.5], [2.5]])
    print([[true], [false]])

    // An empty inner array must not read as a missing element.
    inner_empty: [[int]] = [[]]
    print(inner_empty)

    // A boxed STRUCT element carries no type name, so the runtime formatters
    // alone can only reach the `<struct>` placeholder - never the box's address.
    // The typed element renderer, built from the print site's static type, takes
    // over and prints the value; all three spellings must land on the same one.
    structs = [P { x: 1 }]
    print(structs)
    println(structs)
    print("${structs}")
}

// EXPECT: 1
// EXPECT: 3
// EXPECT: 7
// EXPECT: 42
// EXPECT: hi
// EXPECT: 10 20
// EXPECT: 5
// EXPECT: wyn
// Regression: generics over NON-scalar T. Before nested-aggregate support the
// monomorphizer mapped every non-int/float/bool/string T to `long long`, so a
// generic instantiated over an array/struct force-cast the aggregate, and a
// second Box instantiation with a different concrete type silently miscompiled
// (garbage pointer). Now type args map array->WynArray / struct->the struct's
// own C type, return-type exprs like [T] resolve, and each generic-struct
// instantiation emits a distinct monomorphic struct (Box_int vs Box_string).
struct Point { x: int, y: int }
struct Box<T> { val: T }

fn id<T>(v: T) -> T { return v }
fn pair<T>(x: T) -> [T] { return [x, x] }
// A generic fn that BUILDS `[T]` and one that INDEXES `[T]` used to assume
// T=int: dup<Point> emitted array_push_int (C error), first<Point> emitted
// array_get_int, and `first(dup(p))` monomorphized to first_int (wrong element
// getter). Now the monomorphizer resolves T's real element push/get, and the
// call-site keys the instantiation on the type-param value (first_Point).
fn dup<T>(x: T) -> [T] { return [x, x] }
fn first<T>(xs: [T]) -> T { return xs[0] }

fn main() -> int {
    arr = id([1, 2, 3])          // generic over array
    println("${arr[0]}")          // 1
    p = id(Point{ x: 3, y: 4 })  // generic over struct
    println("${p.x}")             // 3
    pr = pair(7)                  // generic returning [T]
    println("${pr[1]}")           // 7
    b1 = Box{ val: 42 }          // Box<int> (T inferred)
    b2 = Box{ val: "hi" }        // Box<string> (distinct monomorphic type)
    println("${b1.val}")          // 42
    println("${b2.val}")          // hi

    // dup<T> building [T] + first<T> indexing [T], over struct/int/string T.
    q = Point{ x: 10, y: 20 }
    dq = dup(q)                  // [Point] built via push-struct
    fq = first(dq)               // first_Point, struct getter
    println("${fq.x} ${fq.y}")    // 10 20
    di = dup(5)
    println("${first(di)}")       // 5
    ds = dup("wyn")
    println("${first(ds)}")       // wyn
    return 0
}
